# Copy this file to .env and fill it in. .env holds secrets: never commit it or share it.

# The password people type to use the site. Use a long one, for example four random words.
APP_PASSWORD=replace-with-a-long-password

# Your Anthropic API key, used to read briefs. Set a monthly spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Your web address, for example videos.example.com, for HTTPS with a free certificate.
# Leave it as :80 to use the server's IP address over plain HTTP until you have a web address.
SITE_ADDRESS=:80

# Optional. The model that reads briefs (default claude-sonnet-5-5).
# VIDEO_INTERPRETER_MODEL=claude-sonnet-5-5
