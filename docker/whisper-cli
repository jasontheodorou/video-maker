#!/bin/sh
# Runs the whisper-cli build that suits this CPU. On Intel and AMD, whisper-cli-v3 needs AVX2, FMA, F16C and
# BMI2 (most chips since 2013, and the Intel N100). Older and cheaper chips such as the Celeron J4125 and N5105
# lack them, so they get whisper-cli-v2, which needs only SSE4.2. Other machines have one build.
dir=$(dirname "$0")
for b in native v3 v2 arm64 generic; do
  [ -x "$dir/whisper-cli-$b" ] || continue
  if [ "$b" = v3 ]; then
    flags=$(grep -m1 '^flags' /proc/cpuinfo 2>/dev/null)
    case " $flags " in
      *" avx2 "*) ;;
      *) continue ;;
    esac
    for f in fma f16c bmi2; do
      case " $flags " in *" $f "*) ;; *) continue 2 ;; esac
    done
  fi
  exec "$dir/whisper-cli-$b" "$@"
done
echo "whisper-cli: no build for this machine" >&2
exit 1
